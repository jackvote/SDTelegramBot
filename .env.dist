# Это пример файла настроек.
# Для работы скопируйте его, переименуйте в .env (без .dist) и заполните реальными значениями.

# ID администраторов и пользователей (через запятую)
ADMINS=123456789
USERS=123456789,987654321

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAHdfsdfdfssd-jkjygfgfhghhg

# Путь к папке Stable Diffusion (где лежит webui-user.bat)
SD_PATH=E:\stable

# Адрес API Stable Diffusion (ВАЖНО: укажите ваш реальный порт, на котором открыт API Automatic1111)
SD_API_URL=http://127.0.0.1:7860

# ==========================================
# НАСТРОЙКИ PHP-ШЛЮЗА (ПРОКСИ ДЛЯ TELEGRAM)
# Если шлюз не используется, уберите значения после знака равенства или закомментируйте строки символом #
# ==========================================

# Полный URL вашего PHP-скрипта на хостинге
TG_BRIDGE_URL=https://ваш-хостинг.ru/bridge/sdbot.php

# Секретный ключ, который вы задали в переменной $AUTH_KEY в начале PHP-скрипта
TG_BRIDGE_KEY=секретный_ключ_для_соединения_12345
